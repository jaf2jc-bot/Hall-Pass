rules_version = '2';

service cloud.firestore {
match /databases/{database}/documents {

```
// ============================================================
// HELPER FUNCTIONS
// ============================================================

function isAuthenticated() {
  return request.auth != null;
}

function userDocExists() {
  return isAuthenticated() &&
    exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    );
}

function getUserData() {
  return userDocExists()
    ? get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data
    : {};
}

function isAdmin() {
  return isAuthenticated() && (
    request.auth.token.admin == true ||
    (
      userDocExists() &&
      getUserData().role == 'admin'
    ) ||
    request.auth.token.email in [
      'admin@bearworks.jackson.sparcc.org',
      'jaf2jc@bearworks.jackson.sparcc.org'
    ]
  );
}

function isTeacher() {
  return isAuthenticated() && (
    isAdmin() ||
    request.auth.token.teacher == true ||
    (
      userDocExists() &&
      getUserData().role in ['teacher', 'admin']
    )
  );
}

function isStudent() {
  return isAuthenticated() && (
    (
      userDocExists() &&
      getUserData().role == 'student'
    ) ||
    (
      !isTeacher() &&
      !isAdmin()
    )
  );
}


// ============================================================
// 1. USERS
// ============================================================

match /users/{userId} {

  // Users can read their own profile.
  // Teachers and admins can read all profiles.
  allow read: if
    isAuthenticated() &&
    (
      request.auth.uid == userId ||
      isTeacher()
    );

  // ----------------------------------------------------------
  // CREATE
  // ----------------------------------------------------------

  allow create: if
    isAdmin() ||

    (
      isAuthenticated() &&
      request.auth.uid == userId &&
      request.resource.data.role == 'student'
    ) ||

    (
      isAuthenticated() &&
      request.auth.uid == userId &&
      request.resource.data.role == 'teacher' &&
      request.resource.data.teacherDocId != null &&
      exists(
        /databases/$(database)/documents/teachers/$(request.resource.data.teacherDocId)
      ) &&
      get(
        /databases/$(database)/documents/teachers/$(request.resource.data.teacherDocId)
      ).data.email == request.auth.token.email
    );

  // ----------------------------------------------------------
  // UPDATE
  // ----------------------------------------------------------

  allow update: if
    isAdmin() ||

    (
      isAuthenticated() &&
      request.auth.uid == userId &&
      request.resource.data.role == resource.data.role &&
      request.resource.data.teacherDocId == resource.data.teacherDocId &&
      request.resource.data.studentId == resource.data.studentId
    );

  // ----------------------------------------------------------
  // DELETE
  // ----------------------------------------------------------

  allow delete: if isAdmin();
}


// ============================================================
// 2. STUDENTS
// ============================================================

match /students/{studentId} {

  // Teachers/admins can read the entire roster.
  //
  // Students can read their own student document.
  allow read: if
    isTeacher() ||
    (
      isAuthenticated() &&
      (
        resource.data.email == request.auth.token.email ||
        resource.data.studentId == getUserData().studentId ||
        resource.id == getUserData().studentDocId
      )
    );

  // Only admins can modify the roster.
  allow write: if isAdmin();
}


// ============================================================
// 3. TEACHERS
// ============================================================

match /teachers/{teacherId} {

  // All authenticated users can read the teacher directory.
  allow read: if isAuthenticated();

  // Only admins can modify teachers.
  allow write: if isAdmin();
}


// ============================================================
// 4. HALL PASSES
// ============================================================

match /hallPasses/{passId} {

  // ----------------------------------------------------------
  // READ
  // ----------------------------------------------------------
  //
  // Teachers/admins:
  //   Read all hall passes.
  //
  // Students:
  //   Read only their own passes.
  //

  allow read: if
    isTeacher() ||
    (
      isStudent() &&
      (
        resource.data.studentId == getUserData().studentId ||
        resource.data.studentDocId == getUserData().studentDocId ||
        resource.data.studentEmail == request.auth.token.email
      )
    );


  // ----------------------------------------------------------
  // CREATE
  // ----------------------------------------------------------

  allow create: if
    isAuthenticated() &&
    (
      isTeacher() ||

      (
        isStudent() &&
        (
          request.resource.data.studentId == getUserData().studentId ||
          request.resource.data.studentDocId == getUserData().studentDocId ||
          request.resource.data.studentEmail == request.auth.token.email
        ) &&
        request.resource.data.status == 'ACTIVE'
      )
    );


  // ----------------------------------------------------------
  // UPDATE
  // ----------------------------------------------------------

  allow update: if
    isAuthenticated() &&
    (
      isTeacher() ||

      (
        isStudent() &&
        (
          resource.data.studentId == getUserData().studentId ||
          resource.data.studentDocId == getUserData().studentDocId ||
          resource.data.studentEmail == request.auth.token.email
        ) &&
        resource.data.status == 'ACTIVE' &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'timeIn',
            'durationSeconds',
            'durationMinutes',
            'endedBy'
          ]) &&
        request.resource.data.status == 'COMPLETED'
      )
    );


  // ----------------------------------------------------------
  // DELETE
  // ----------------------------------------------------------

  allow delete: if isAdmin();
}


// ============================================================
// 5. CONFLICT PAIRS
// ============================================================

match /conflictPairs/{conflictPairId} {

  // Teachers/admins can view conflict pairs.
  allow read: if isTeacher();

  // Teachers/admins can create conflict pairs.
  allow create: if isTeacher();

  // Teachers/admins can delete conflict pairs.
  allow delete: if isTeacher();

  // Conflict pairs are not edited after creation.
  allow update: if isTeacher();
}


// ============================================================
// 6. STUDENT REQUESTS
// ============================================================
//
// This is the teacher-to-teacher student request system.
//
// A teacher can:
//   - Create a request for a student.
//   - Read requests.
//   - Update requests.
//
// Admins can do everything.
//
// Students are not allowed to access this collection.
//
// ============================================================

match /studentRequests/{requestId} {

  // Teachers/admins can read requests.
  allow read: if isTeacher();

  // Teachers/admins can create requests.
  allow create: if isTeacher();

  // Teachers/admins can update requests.
  allow update: if isTeacher();

  // Only admins can delete requests.
  allow delete: if isAdmin();
}


// ============================================================
// 7. STUDENT HALL PASS REQUESTS
// ============================================================
//
// This is the student-to-teacher hall pass approval system.
//
// Student:
//   createStudentHallPassRequest()
//
// creates a document with:
//
//   status: 'PENDING'
//
// The teacher then sees the request and can:
//
//   APPROVE
//   DENY
//
// When approved, the application creates an ACTIVE hall pass.
//
// ============================================================

match /studentHallPassRequests/{requestId} {

  // ----------------------------------------------------------
  // READ
  // ----------------------------------------------------------
  //
  // Admin:
  //   Everything.
  //
  // Teacher:
  //   Requests assigned to that teacher.
  //
  // Student:
  //   Their own requests.
  //
  // IMPORTANT:
  // The application queries this collection using:
  //
  //   teacherId == teacherId
  //
  // or:
  //
  //   studentId == studentId
  //
  // Therefore the authenticated role is used here instead
  // of trying to make Firestore infer the query's intent.
  //

  allow read: if
    isAdmin() ||

    isTeacher() ||

    (
      isStudent() &&
      resource.data.studentId == getUserData().studentId
    );


  // ----------------------------------------------------------
  // CREATE
  // ----------------------------------------------------------
  //
  // Students can create a request only for themselves.
  //
  // Teachers/admins can also create requests.
  //

  allow create: if
    isAdmin() ||

    isTeacher() ||

    (
      isStudent() &&
      request.resource.data.studentId == getUserData().studentId &&
      request.resource.data.studentDocId == getUserData().studentDocId &&
      request.resource.data.studentEmail == request.auth.token.email &&
      request.resource.data.status == 'PENDING'
    );


  // ----------------------------------------------------------
  // UPDATE
  // ----------------------------------------------------------
  //
  // Students cannot modify requests.
  //
  // Teachers can modify requests.
  //
  // Admins can modify anything.
  //
  // The application controls which status changes are made.
  //

  allow update: if
    isAdmin() ||
    isTeacher();


  // ----------------------------------------------------------
  // DELETE
  // ----------------------------------------------------------

  allow delete: if isAdmin();
}


// ============================================================
// 8. SCHOOL SETTINGS
// ============================================================

match /settings/{docId} {

  // Authenticated users can read settings.
  allow read: if isAuthenticated();

  // Only admins can modify settings.
  allow write: if isAdmin();
}


// ============================================================
// DEFAULT DENY
// ============================================================

match /{document=**} {
  allow read, write: if false;
}
```

}
}
