rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocExists() {
      return isAuthenticated() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function getUserData() {
      return userDocExists()
        ? get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data
        : {};
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||

        (
          userDocExists() &&
          getUserData().role == 'admin'
        ) ||

        request.auth.token.email in [
          'admin@bearworks.jackson.sparcc.org',
          'jaf2jc@bearworks.jackson.sparcc.org'
        ]
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        isAdmin() ||

        request.auth.token.teacher == true ||

        (
          userDocExists() &&
          getUserData().role in [
            'teacher',
            'admin'
          ]
        )
      );
    }

    function isStudent() {
      return isAuthenticated() && (
        (
          userDocExists() &&
          getUserData().role == 'student'
        ) ||

        (
          !isTeacher() &&
          !isAdmin()
        )
      );
    }


    // ============================================================
    // 1. USERS
    // ============================================================

    match /users/{userId} {

      // Users can read their own profile.
      // Teachers/Admins can read user profiles.
      allow read: if
        isAuthenticated() &&
        (
          request.auth.uid == userId ||
          isTeacher()
        );

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create: if
        isAdmin() ||

        (
          isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.role == 'student'
        ) ||

        (
          isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.role == 'teacher' &&
          request.resource.data.teacherDocId != null &&
          exists(
            /databases/$(database)/documents/teachers/$(request.resource.data.teacherDocId)
          ) &&
          get(
            /databases/$(database)/documents/teachers/$(request.resource.data.teacherDocId)
          ).data.email == request.auth.token.email
        );

      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------

      allow update: if
        isAdmin() ||

        (
          isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.teacherDocId == resource.data.teacherDocId &&
          request.resource.data.studentId == resource.data.studentId
        );

      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAdmin();
    }


    // ============================================================
    // 2. STUDENTS
    // ============================================================

    match /students/{studentDocId} {

      // Teachers/Admins can read the entire roster.
      //
      // Students can only read their own student record.
      allow read: if
        isTeacher() ||

        (
          isAuthenticated() &&
          (
            resource.data.email == request.auth.token.email ||

            (
              userDocExists() &&
              resource.data.studentId == getUserData().studentId
            ) ||

            (
              userDocExists() &&
              resource.id == getUserData().studentDocId
            )
          )
        );

      // Admins can modify the roster freely.
      //
      // Anyone authenticated may also CREATE a students doc for
      // THEMSELVES (email must match their own auth token) — this
      // is what lets a person's first login auto-add them to the
      // roster instead of requiring an admin to hand-enter every
      // student ahead of time. It does not allow creating a
      // record for someone else, and updates/deletes always
      // require an admin.
      //
      // The app always stores emails lowercased, so the token
      // side of this comparison is lowercased too.
      allow create: if
        isAdmin() ||
        (
          isAuthenticated() &&
          request.resource.data.email ==
            request.auth.token.email.lower()
        );

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // 3. TEACHERS
    // ============================================================

    match /teachers/{teacherId} {

      // All authenticated users may read the faculty directory.
      allow read: if isAuthenticated();

      // Only Admins can modify teachers.
      allow write: if isAdmin();
    }


    // ============================================================
    // 4. HALL PASSES
    // ============================================================

    match /hallPasses/{passId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      //
      // Teachers/Admins:
      //   Can read all hall passes.
      //
      // Students:
      //   Can only read their own hall passes.
      //

      allow read: if
        isTeacher() ||

        (
          isAuthenticated() &&
          (
            resource.data.studentId == getUserData().studentId ||

            resource.data.studentDocId == getUserData().studentDocId ||

            resource.data.studentEmail == request.auth.token.email
          )
        );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------
      //
      // Teachers/Admins can create passes for any student.
      //
      // Students can only create an ACTIVE pass for themselves.
      //

      allow create: if
        isAuthenticated() &&
        (
          isTeacher() ||

          (
            (
              request.resource.data.studentId == getUserData().studentId ||

              request.resource.data.studentDocId == getUserData().studentDocId ||

              request.resource.data.studentEmail == request.auth.token.email
            ) &&

            request.resource.data.status == 'ACTIVE'
          )
        );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------
      //
      // Teachers/Admins can update passes.
      //
      // Students can only complete their own active pass.
      //

      allow update: if
        isAuthenticated() &&
        (
          isTeacher() ||

          (
            (
              resource.data.studentId == getUserData().studentId ||

              resource.data.studentDocId == getUserData().studentDocId ||

              resource.data.studentEmail == request.auth.token.email
            ) &&

            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'timeIn',
                'durationSeconds',
                'durationMinutes',
                'endedBy'
              ]) &&

            request.resource.data.status == 'COMPLETED'
          )
        );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAdmin();
    }


    // ============================================================
    // 5. SCHOOL SETTINGS
    // ============================================================

    match /settings/{docId} {

      allow read: if isAuthenticated();

      allow write: if isAdmin();
    }


    // ============================================================
    // 6. CONFLICT PAIRS
    // ============================================================
    //
    // Used by the teacher/admin dashboard to manage students
    // who should not be placed together.
    //
    // Teachers need to READ conflict pairs.
    // Admins can CREATE/UPDATE/DELETE them.
    //

    match /conflictPairs/{conflictPairId} {

      // Teachers and Admins can view conflict pairs.
      allow read: if isTeacher();

      // Only Admins can create conflict pairs.
      allow create: if isAdmin();

      // Only Admins can modify conflict pairs.
      allow update: if isAdmin();

      // Only Admins can delete conflict pairs.
      allow delete: if isAdmin();
    }


    // ============================================================
    // 7. TEACHER-TO-TEACHER STUDENT REQUESTS
    // ============================================================
    //
    // Collection:
    //   studentRequests
    //
    // These are requests where one teacher requests a student
    // from another teacher's classroom.
    //

    match /studentRequests/{requestId} {

      // Teachers/Admins can view student requests.
      allow read: if isTeacher();

      // Teachers/Admins can create student requests.
      allow create: if isTeacher();

      // Teachers/Admins can update request status.
      allow update: if isTeacher();

      // Only Admins can delete requests.
      allow delete: if isAdmin();
    }


    // ============================================================
    // 8. STUDENT HALL PASS REQUESTS
    // ============================================================
    //
    // Collection:
    //   studentHallPassRequests
    //
    // Flow:
    //
    //   Student
    //       |
    //       | creates request
    //       v
    //   PENDING
    //       |
    //       | Teacher approves
    //       v
    //   APPROVED
    //       |
    //       | Hall pass is created
    //       v
    //   ACTIVE HALL PASS
    //
    // Students:
    //   - Can create their own requests.
    //   - Can read their own requests.
    //
    // Teachers/Admins:
    //   - Can read requests assigned to them.
    //   - Can approve/deny requests.
    //

    match /studentHallPassRequests/{requestId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      //
      // A student can read requests belonging to that student.
      //
      // Teachers/Admins can read requests assigned to them.
      //

      allow read: if
        isTeacher() ||

        (
          isAuthenticated() &&
          (
            resource.data.studentId == getUserData().studentId ||

            resource.data.studentDocId == getUserData().studentDocId ||

            resource.data.studentEmail == request.auth.token.email
          )
        );


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------
      //
      // Students can create a request only for themselves.
      //
      // Teachers/Admins may also create requests if needed.
      //

      allow create: if
        isAuthenticated() &&
        (
          isTeacher() ||

          (
            request.resource.data.studentId == getUserData().studentId ||

            request.resource.data.studentDocId == getUserData().studentDocId ||

            request.resource.data.studentEmail == request.auth.token.email
          )
        );


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------
      //
      // Teachers/Admins can approve or deny requests.
      //
      // Students may cancel (withdraw) their OWN request, but
      // only while it's still PENDING, and only by flipping the
      // status to CANCELLED — they cannot touch any other field
      // or cancel a request that's already been approved/denied.
      //

      allow update: if
        isTeacher() ||

        (
          isAuthenticated() &&

          (
            resource.data.studentId == getUserData().studentId ||

            resource.data.studentDocId == getUserData().studentDocId ||

            resource.data.studentEmail == request.auth.token.email
          ) &&

          resource.data.status == 'PENDING' &&

          request.resource.data.status == 'CANCELLED' &&

          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['status', 'cancelledAt'])
        );


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAdmin();
    }


    // ============================================================
    // 9. DENY EVERYTHING ELSE
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
